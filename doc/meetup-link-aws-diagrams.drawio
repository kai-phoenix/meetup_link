    <diagram id="p1_incident_path" name="1 インシデント経路">
        <mxGraphModel dx="599" dy="539" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="none" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
