    <diagram id="p4_remediation_flow" name="4 再公開作業フロー">
        <mxGraphModel dx="940" dy="492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="none" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="Remediation Flow / 再公開までの作業フロー（Runbook Phase 1〜10 に対応）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_1" value="&lt;b&gt;Phase 1&lt;/b&gt;&lt;br&gt;ECS停止を維持&lt;br&gt;desired count = 0&lt;br&gt;Flow LogsがACTIVEか確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="120" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_2" value="&lt;b&gt;Phase 2&lt;/b&gt;&lt;br&gt;アプリ修正&lt;br&gt;NGINX autoindex off&lt;br&gt;APP_DEBUG=false 確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="330" y="120" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_3" value="&lt;b&gt;Phase 3&lt;/b&gt;&lt;br&gt;依存関係更新&lt;br&gt;composer audit / npm audit&lt;br&gt;criticalは原則0にする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="600" y="120" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_4" value="&lt;b&gt;Phase 4&lt;/b&gt;&lt;br&gt;Secrets ローテーション&lt;br&gt;APP_KEY / DB_PASSWORD&lt;br&gt;RDSパスワードも変更" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="120" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_5" value="&lt;b&gt;Phase 5&lt;/b&gt;&lt;br&gt;ECR scan-on-push 有効化&lt;br&gt;app / front / proxy の3リポジトリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="120" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_6" value="&lt;b&gt;Phase 6&lt;/b&gt;&lt;br&gt;固定タグでbuild / push&lt;br&gt;latestは使わない&lt;br&gt;scan結果でcriticalなら中止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="290" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_7" value="&lt;b&gt;Phase 7&lt;/b&gt;&lt;br&gt;Task Definition作り直し&lt;br&gt;固定タグ参照 / secrets参照&lt;br&gt;logConfiguration確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="290" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_8" value="&lt;b&gt;Phase 8&lt;/b&gt;&lt;br&gt;ECS SG egress最小化&lt;br&gt;3306 → RDS SG&lt;br&gt;443 → VPC Endpoint SG&lt;br&gt;&lt;b&gt;0.0.0.0/0 全許可は戻さない&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="600" y="280" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p4_8b" value="&lt;b&gt;Phase 8-2（推奨・追加）&lt;/b&gt;&lt;br&gt;VPC Endpointを作成&lt;br&gt;（ecr.api / ecr.dkr / logs /&lt;br&gt;secretsmanager / s3 GW）&lt;br&gt;→ NAT Gatewayを削除&lt;br&gt;&lt;i&gt;※Runbookでは「後で」だが、&lt;br&gt;先にやると出口が物理的に消える&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="265" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_8c" value="&lt;b&gt;Phase 8-3&lt;/b&gt;&lt;br&gt;AWS Budgets設定&lt;br&gt;$10 / $20 / $50&lt;br&gt;（起動前に入れておく）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="285" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_9" value="&lt;b&gt;Phase 9&lt;/b&gt;&lt;br&gt;desired count = 1 で再公開&lt;br&gt;deployment circuit breaker&lt;br&gt;(rollback=true) を有効に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="470" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_10" value="&lt;b&gt;Phase 9-2&lt;/b&gt;&lt;br&gt;ALB Target Groupが&lt;br&gt;healthy になるか確認&lt;br&gt;/api/health を実装しておく" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="330" y="470" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_11" value="&lt;b&gt;Phase 10&lt;/b&gt;&lt;br&gt;監視&lt;br&gt;Flow Logs / CloudWatch Logs / Billing&lt;br&gt;Logs Insightsで宛先の広がりと&lt;br&gt;危険ポートを確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="600" y="460" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4_dec" value="不審な通信 /&lt;br&gt;Billing異常 /&lt;br&gt;AWS通知はあるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="890" y="450" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_yes" value="&lt;b&gt;YES: 即停止&lt;/b&gt;&lt;br&gt;desired count = 0&lt;br&gt;→ Flow Logsで宛先を特定&lt;br&gt;→ 原因を潰してからPhase 6へ戻る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="440" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p4_no" value="&lt;b&gt;NO: 稼働継続&lt;/b&gt;&lt;br&gt;監視を継続&lt;br&gt;VPC Endpoint化とNAT削除を&lt;br&gt;未実施なら仕上げる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="890" y="660" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p4_check" value="&lt;b&gt;再公開判定チェックリスト（Runbook 12章と対応）&lt;/b&gt;&lt;br&gt;□ 作業中 desired count = 0 を維持した　　　□ VPC Flow Logs が ACTIVE&lt;br&gt;□ ECS SG に 0.0.0.0/0 全許可を戻していない　□ NGINX autoindex off　　□ APP_DEBUG=false&lt;br&gt;□ composer / npm の critical・high を確認・対応　□ ECR scan-on-push 有効　□ scan結果を確認&lt;br&gt;□ Task Definitionで latest を使っていない　　□ Secrets / DBパスワードをローテーション&lt;br&gt;□ ECS→RDS 3306 をSG参照で許可　　□ 443の扱いを決めた（VPC Endpoint / 暫定NAT）&lt;br&gt;□ CloudWatch Logsでアプリログが見える　　□ Budgetアラート設定済み&lt;br&gt;□ desired count=1 に戻した後、Flow Logsを確認した" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontSize=11;" parent="1" vertex="1">
