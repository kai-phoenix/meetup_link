                    <mxGeometry x="40" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p1_meta" value="AWS Account: 非公開 / Region: us-east-1&lt;br&gt;VPC vpc-xxxxxxxx&lt;br&gt;Abuse通知: 2026-07（詳細時刻はマスク）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="770" y="20" width="330" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p1_alb" value="Public ALB&lt;br&gt;HTTP 80 / HTTPS 443&lt;br&gt;ALB SG sg-xxxxxxxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="60" y="140" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p1_ecs" value="ECS Fargate Task&lt;br&gt;meetup-link-service&lt;br&gt;(app + front + proxy / latestタグ)&lt;br&gt;※送信元として最有力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="60" y="300" width="200" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1_sg" value="ECS Task SG&lt;br&gt;sg-xxxxxxxx&lt;br&gt;Inbound: TCP 80 (ALB SGのみ)&lt;br&gt;&lt;b&gt;Outbound: All traffic 0.0.0.0/0&lt;/b&gt;&lt;br&gt;※当時の最大の問題" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="330" y="290" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1_rt" value="Private Route Tables&lt;br&gt;rtb-xxxxxxxx&lt;br&gt;rtb-xxxxxxxx&lt;br&gt;0.0.0.0/0 -&gt; NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="620" y="300" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1_nat" value="NAT Gateway&lt;br&gt;nat-xxxxxxxx&lt;br&gt;Public Subnet subnet-xxxxxxxx&lt;br&gt;&lt;b&gt;EIP: x.x.x.x（マスク）&lt;/b&gt;&lt;br&gt;※Abuse報告IPと一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="900" y="290" width="230" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1_internet" value="Internet Remote Hosts&lt;br&gt;脆弱性スキャン様の通信&lt;br&gt;(9200 / 80 / 443 など)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1190" y="310" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p1_rds" value="RDS MySQL&lt;br&gt;RDS SG sg-xxxxxxxx&lt;br&gt;Private Subnetのみ&lt;br&gt;ENIはRDS Network Interfaceのみ&lt;br&gt;※外部スキャンの発信源ではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="240" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1_weak" value="&lt;b&gt;当時残っていた弱点（AppSec調査結果）&lt;/b&gt;&lt;br&gt;・composer audit: high複数 / npm audit: critical・high複数&lt;br&gt;・ECR scan-on-push 無効&lt;br&gt;・image tagが latest（再現性・追跡性なし）&lt;br&gt;・NGINX /storage に autoindex on&lt;br&gt;・taskRoleArn は null（AWS API権限はなし）&lt;br&gt;→ 明確なSSRF / RCE実装は未検出。直接原因は断定不可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="330" y="490" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p1_flow" value="&lt;b&gt;VPC Flow Logs: 当時 無効&lt;/b&gt;&lt;br&gt;describe-flow-logs = []&lt;br&gt;→ srcAddr / dstAddr / dstPort を&lt;br&gt;事後に確定できず&lt;br&gt;→ 正確なTask ENI / Private IPも特定不能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="490" width="270" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1_trail" value="&lt;b&gt;CloudTrail: 侵害痕跡なし&lt;/b&gt;&lt;br&gt;CreateUser / CreateAccessKey /&lt;br&gt;AttachUserPolicy / RunInstances /&lt;br&gt;StartSession / SendCommand = 0件&lt;br&gt;GetSecretValue は ecsTaskExecutionRole のみ&lt;br&gt;→ IAM / AWS APIレベルの侵害はなし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="490" width="280" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1_note" value="&lt;b&gt;結論の切り分け&lt;/b&gt;　（AWS Trust &amp;amp; Safety へは most likely source として報告し、対応済みと判定された）&lt;br&gt;・確定できたこと: 報告IP = NAT GatewayのEIP。NAT経由で外向き通信が出ていた。&lt;br&gt;・最有力: NAT配下で外部通信できたcomputeはECS Fargateタスクのみ（EC2は存在せず、Private Subnet内の残存ENIはRDSだけ）。&lt;br&gt;・断定不可: Flow Logs無効のため、どのタスク・どのプロセス・どの宛先ポートかは証拠ベースで追えない。&lt;br&gt;・実行可能条件: ECS Task SGのoutbound全許可。これがあると、コンテナが悪用された場合に任意IP・任意ポートへ通信できてしまう。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="700" width="1330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e1" value="HTTP 80&lt;br&gt;(ALB SGのみ)" style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p1_alb" target="p1_ecs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e2" value="コンテナからの&lt;br&gt;outbound" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;" parent="1" source="p1_ecs" target="p1_sg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e3" value="全ポート・全宛先&lt;br&gt;を許可" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;" parent="1" source="p1_sg" target="p1_rt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e4" value="0.0.0.0/0" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;" parent="1" source="p1_rt" target="p1_nat" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e5" value="SNAT&lt;br&gt;送信元が&lt;br&gt;EIPに変換" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B85450;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;labelBackgroundColor=none;" parent="1" source="p1_nat" target="p1_internet" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p1_e6" value="TCP 3306&lt;br&gt;(正常通信)" style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p1_ecs" target="p1_rds" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e7" value="Abuse報告&lt;br&gt;送信元IP" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;strokeColor=#B85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="p1_nat" target="p1_meta" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_mask" value="&lt;b&gt;※公開用（マスク済み）&lt;/b&gt;　AWSアカウントID / VPC / サブネット / セキュリティグループ / NAT Gateway / Flow LogのIDおよびEIPは xxxxxxxx・x.x.x.x に置換しています。実IDは非公開の内部版で管理し、リポジトリには含めていません。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="855" width="1330" height="35" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p2_target_logical" name="2 再公開構成（論理）">
        <mxGraphModel dx="940" dy="492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2_title" value="Target Architecture / 再公開時の安全寄り構成（論理図・通信要件ベース）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_meta" value="AWS Account: 非公開 / Region: us-east-1&lt;br&gt;VPC vpc-xxxxxxxx&lt;br&gt;※デプロイ手順書はap-northeast-1推奨。既存資産はus-east-1のため図はus-east-1で統一" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="770" y="20" width="470" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_user" value="ユーザー / ブラウザ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="150" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p2_r53" value="Route53 + ACM&lt;br&gt;meetup-link.com&lt;br&gt;ALBへAliasレコード&lt;br&gt;ACM証明書はus-east-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="290" width="150" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_budget" value="AWS Budgets + SNS&lt;br&gt;$10 / $20 / $50&lt;br&gt;でメール通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="470" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2_gha" value="GitHub Actions&lt;br&gt;OIDCでAssumeRole&lt;br&gt;（アクセスキーなし）&lt;br&gt;固定タグでbuild / push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="640" width="150" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p2_igw" value="Internet Gateway&lt;br&gt;インターネット公開は&lt;br&gt;ALBのみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="250" y="145" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p2_alb" value="Public ALB&lt;br&gt;（パブリックサブネット x 2AZ）&lt;br&gt;HTTPS 443 で受け、HTTP 80は443へリダイレクト&lt;br&gt;Target Group: type=IP / port 80 / HC=/api/health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="460" y="130" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecs" value="ECS Fargate&lt;br&gt;（プライベートサブネット x 2AZ）&lt;br&gt;proxy + app + front を1タスク同居&lt;br&gt;固定イメージタグ運用（latest禁止）&lt;br&gt;assignPublicIp = DISABLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="770" y="130" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_rds" value="RDS MySQL&lt;br&gt;プライベートサブネットのみ&lt;br&gt;Publicly accessible = 無効&lt;br&gt;session / cache / queue も&lt;br&gt;DB driverなので必須依存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1090" y="130" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_albsg" value="ALB SG&lt;br&gt;sg-xxxxxxxx&lt;br&gt;In: 443 / 80 from 0.0.0.0/0&lt;br&gt;Out: ECS SG向け 80のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1">
                    <mxGeometry x="460" y="290" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecssg" value="&lt;b&gt;ECS Task SG sg-xxxxxxxx&lt;/b&gt;&lt;br&gt;In : TCP 80 from ALB SG のみ&lt;br&gt;Out: TCP 3306 → RDS SG&lt;br&gt;Out: TCP 443 → VPC Endpoint SG&lt;br&gt;&lt;b&gt;All traffic / 0.0.0.0/0 は復活させない&lt;/b&gt;&lt;br&gt;※現在egress 0件。0件のままではimage pullもSecrets取得もできず起動しないので、上の2本を必ず入れる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="770" y="290" width="250" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p2_rdssg" value="RDS SG&lt;br&gt;sg-xxxxxxxx&lt;br&gt;In: TCP 3306 from ECS SG のみ&lt;br&gt;Out: 不要（追加しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="290" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_vpce" value="VPC Endpoints（推奨・NAT代替）&lt;br&gt;Interface: ecr.api / ecr.dkr / logs / secretsmanager&lt;br&gt;Gateway: s3（ECRレイヤ取得に必須）&lt;br&gt;Endpoint SG: In TCP 443 from ECS SG のみ&lt;br&gt;→ これを入れるとNAT Gatewayを廃止でき、&lt;br&gt;　 インターネットへの出口自体がなくなる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="740" y="510" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_nat" value="NAT Gateway&lt;br&gt;&lt;b&gt;原則 削除&lt;/b&gt;（今回のAbuse経路そのもの）&lt;br&gt;VPC Endpointが揃うまでの暫定でのみ利用&lt;br&gt;使う場合は TCP 443 のみに限定し、&lt;br&gt;Flow Logsで宛先を必ず確認する&lt;br&gt;（コスト面でも約35USD/月の削減）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="510" width="230" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecr" value="ECR&lt;br&gt;meetup-link-app / -front / -proxy&lt;br&gt;scan-on-push 有効&lt;br&gt;固定タグのみ（例 20260808-rebuild / git short sha）&lt;br&gt;criticalが残るimageは公開しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="440" y="430" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_sm" value="Secrets Manager&lt;br&gt;アプリ用シークレット（1件に集約）&lt;br&gt;APP_KEY / DB_PASSWORD&lt;br&gt;再公開前にローテーション&lt;br&gt;取得は ecsTaskExecutionRole のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="440" y="600" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_logs" value="CloudWatch Logs&lt;br&gt;/ecs/meetup-link（app / front / proxy）&lt;br&gt;/aws/vpc/flowlogs/meetup-link&lt;br&gt;Logs Insightsでスキャン様通信を定期確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="740" y="720" width="310" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="2lBDMQMcQC7sA9fgPv0I-1" value="" style="edgeStyle=none;html=1;labelBackgroundColor=default;" edge="1" parent="1" source="p2_flow" target="p2_logs">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_flow" value="VPC Flow Logs&lt;br&gt;fl-xxxxxxxx&lt;br&gt;Traffic type: ALL&lt;br&gt;Status: ACTIVE&lt;br&gt;宛先: cloud-watch-logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1090" y="720" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2_app" value="アプリ側の前提&lt;br&gt;APP_ENV=production / APP_DEBUG=false&lt;br&gt;NGINX /storage は autoindex off&lt;br&gt;composer audit / npm audit のcriticalを解消&lt;br&gt;taskRoleは必要になったら最小権限で作成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="210" y="790" width="290" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p2_rule" value="&lt;b&gt;この図で守っている原則&lt;/b&gt;&lt;br&gt;・インターネットに直接公開するのはALBだけ。ECS / RDS はプライベートサブネット。&lt;br&gt;・RDSはPublicly accessibleを絶対に有効化しない。&lt;br&gt;・ECS SGのoutboundを全許可にしない（宛先はSG参照、ポートは3306と443だけ）。&lt;br&gt;・AWS APIへの経路はNATではなくVPC Endpointを第一選択にし、外向きの出口をなくす。&lt;br&gt;・VPC Flow LogsとCloudWatch Logsを最初から有効にし、異常時はdesired count=0で即停止できる状態を保つ。&lt;br&gt;・imageは固定タグ＋scan-on-push。Secretsはローテーション済みのものを使う。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="530" y="860" width="790" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e1" value="HTTPS &lt;br&gt;443" style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" parent="1" source="p2_user" target="p2_igw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e2" value="名前解決&lt;br&gt;（ALBのAlias）" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="p2_r53" target="p2_user" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
